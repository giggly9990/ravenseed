# Read by ravenseed.service. See .env.example in the repository for every
# setting. Restart the service after editing: systemctl restart ravenseed
WEB_DIR=/usr/share/ravenseed/web
DATABASE_PATH=/var/lib/ravenseed/discovery.db
LISTEN_ADDR=127.0.0.1
LISTEN_PORT=8080
QUI_URL=
QUI_API_KEY=
TMDB_TOKEN=
AUTH_MODE=
API_TOKEN=
LOG_LEVEL=info
