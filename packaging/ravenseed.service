[Unit]
Description=RavenSeed
Documentation=https://github.com/giggly9990/ravenseed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ravenseed
Group=ravenseed
EnvironmentFile=/etc/ravenseed/ravenseed.env
ExecStart=/usr/bin/ravenseed
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StateDirectory=ravenseed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/ravenseed

[Install]
WantedBy=multi-user.target
