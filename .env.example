APP_PORT=8088
BIND_ADDRESS=127.0.0.1
TZ=UTC
QUI_URL=
QUI_API_KEY=
TMDB_TOKEN=
# Empty: none without API_TOKEN, token mode with it; session for browser login.
AUTH_MODE=
WEB_USERNAME=
WEB_PASSWORD=
WEB_PASSWORD_FILE=
WEB_PASSWORD_HASH=
WEB_PASSWORD_HASH_FILE=
WEB_COOKIE_SECURE=true
ALLOW_UNAUTHENTICATED_REMOTE=false
TRUSTED_PROXIES=
# Host names/IPs served while AUTH_MODE=none (loopback is always allowed),
# comma-separated, e.g. ravenseed.lan,192.168.1.10. Ignored when auth is on.
ALLOWED_HOSTS=
MAX_CONCURRENT_UPLOADS=1
UA_SUBMISSION_INTERVAL=1m
HISTORY_RETENTION=0
RAW_RESULT_RETENTION=0
# At least 24 characters. With AUTH_MODE empty it enables token mode; an
# explicit AUTH_MODE=none with a token fails at startup.
API_TOKEN=
DEFAULT_TARGET_INDEXER=0
# 1 to 1000
DEFAULT_MIN_COVERAGE=2
SEARCH_TIMEOUT=3m
MAX_CONCURRENT_SEARCHES=4
MAX_ACTIVE_JOBS=8
RESULT_CACHE_TTL=24h
LOG_LEVEL=info

# The binary also reads these. docker-compose.yml does not pass them to the
# container; set them in a Compose override (see README, Docker secrets) or
# when running the binary directly. A *_FILE value takes precedence over the
# variable it names.
# QUI_API_KEY_FILE=/run/secrets/qui_api_key
# TMDB_TOKEN_FILE=/run/secrets/tmdb_token
# API_TOKEN_FILE=/run/secrets/api_token
# TMDB_BASE_URL=https://api.themoviedb.org/3

# Demo stack only (docker-compose.demo.yml). Defaults shown.
# DEMO_BIND_ADDRESS=127.0.0.1
# DEMO_SUBNET=10.247.89.0/24
# DEMO_EDGE_SUBNET=10.247.90.0/24  (also update demo/nginx.conf's geo block)
# DEMO_PROXY_IP=10.247.89.250  (must be inside DEMO_SUBNET)
# DEMO_ALLOWED_HOSTS=ravenseed  (add the public demo hostname; keep ravenseed)

# scripts/demo-seed.mjs reads MOCK_QUI_URL from its own environment, not from
# this file: the mock services' URL as RavenSeed reaches them.
# MOCK_QUI_URL=http://mock-qui:7476
